// This is your Prisma schema file for Taqwa — Quran Management System
// Database: MySQL
// Generator: Prisma Client (TypeScript)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  TEACHER
  PARENT
  STUDENT
  ADULT_STUDENT
  MANAGER
}

enum Memorization {
  MEMORIZING
  SMALLREVISION
  BIGREVISION
}

enum MemorizationSubject {
  QURAN
  HADITH
}

// What a memorization row's amountDone counts. Quran is always PAGE; a hadith
// row is counted in single hadiths or in pages, as the teacher picks.
enum ProgressUnit {
  PAGE
  HADITH
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum JustificationReasonType {
  ILLNESS
  OCCASION
  OTHER
}

enum FineKind {
  CHARGE
  REDUCTION
}

enum FineSource {
  ABSENCE
  LATE
  MISSED_MEMORIZATION
  MANUAL
}

enum PointSource {
  MEMORIZATION
  PRESENT
  ABSENCE
  MISSED_MEMORIZATION
  MANUAL
}

// ─────────────────────────────────────────────────────────────────────────────
// User — core identity, owns auth credentials
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                 Int      @id @default(autoincrement())
  fullName           String   @db.VarChar(100)
  phone              String?  @db.VarChar(20)
  email              String?  @db.VarChar(150)
  passwordHash       String?  @db.VarChar(255)
  // Set whenever an admin sets the password (new account or reset), so the
  // holder replaces it on their next login. Never set for an ADMIN.
  mustChangePassword Boolean  @default(false)
  role               Role
  avatar             String?  @db.VarChar(500)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  teacher             Teacher?
  parent              Parent?
  student             Student?
  manager             Manager?
  notifications       Notification[]
  deviceTokens        DeviceToken[]
  finesCreated        FineEntry[]
  points              PointEntry[]         @relation("PointOwner")
  pointsCreated       PointEntry[]         @relation("PointCreator")
  announcements       HalaqaAnnouncement[]
  chatMessages        ChatMessage[]        @relation("ChatMessageSender")
  chatReads           ChatRead[]
  studentOfMonthPicks StudentOfMonth[]

  @@index([phone])
  @@index([email])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// Teacher
// ─────────────────────────────────────────────────────────────────────────────

model Teacher {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  hireDate    DateTime @default(now())
  // Granted by the admin: lets the teacher post news to their own halaqas,
  // the way a manager does to the halaqas assigned to them.
  canPostNews Boolean  @default(false)

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  halaqas     Halaqa[]
  evaluations Evaluation[]
  notes       StudentNote[]

  @@map("teachers")
}

// ─────────────────────────────────────────────────────────────────────────────
// Parent
// ─────────────────────────────────────────────────────────────────────────────

model Parent {
  id      Int     @id @default(autoincrement())
  userId  Int     @unique
  address String? @db.VarChar(300)

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  students         Student[]
  chatConversation ChatConversation?

  @@map("parents")
}

// ─────────────────────────────────────────────────────────────────────────────
// Student
// ─────────────────────────────────────────────────────────────────────────────

model Student {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique
  birthDate      DateTime?
  // Optional: families sign in by phone, and many registration sheets leave
  // the address blank.
  address        String?
  halaqaId       Int?
  enrollmentDate DateTime  @default(now())
  parentId       Int?
  finishedMemo   Boolean   @default(false)
  // Free text rather than an enum: teachers word the overall rating however
  // they like ("ممتاز", "جيد جداً", "يحتاج مراجعة"), so the set is not fixed.
  currentRating  String?
  // Admin-set opt-in: gates both whether the teacher's recitation sheet
  // offers a Hadith subject for this student and whether the server accepts
  // a HADITH-subject write for him. Derived from hadithBooks on every write:
  // true exactly when at least one book is assigned.
  tracksHadith   Boolean   @default(false)
  // The hadith books (names from HADITH_BOOKS) the admin assigned, as a JSON
  // string array in list order. The teacher picks only from these, and a
  // HADITH write naming any other book is refused.
  hadithBooks    Json?

  // Registration-form details (استمارة التسجيل). All optional: students
  // enrolled before the form existed carry none of them. schoolLevel is the
  // child's school grade or the adult's education level; the father/mother
  // jobs are child-only, occupation and isMarried adult-only.
  schoolLevel        String?  @db.VarChar(100)
  healthStatus       String?  @db.VarChar(255)
  familyStatus       String?  @db.VarChar(255)
  fatherJob          String?  @db.VarChar(100)
  motherJob          String?  @db.VarChar(100)
  occupation         String?  @db.VarChar(100)
  externalActivities String?  @db.VarChar(255)
  isMarried          Boolean?

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent         Parent?                @relation(fields: [parentId], references: [id], onDelete: SetNull)
  halaqa         Halaqa?                @relation(fields: [halaqaId], references: [id])
  attendance     Attendance[]
  memorization   MemorizationProgress[]
  evaluations    Evaluation[]
  notes          StudentNoteRecipient[]
  justifications AbsenceJustification[]
  fines          FineEntry[]
  notifications  Notification[]
  monthAwards    StudentOfMonth[]

  @@index([parentId])
  @@map("students")
}

// ─────────────────────────────────────────────────────────────────────────────
// Halaqa (Quran circle / class)
// ─────────────────────────────────────────────────────────────────────────────

model Halaqa {
  id        Int     @id @default(autoincrement())
  name      String  @db.VarChar(150)
  level     String? @db.VarChar(100)
  teacherId Int

  // An adults' halaqa runs on fines. The flag is stored rather than derived
  // from whether the rates are set, so a half-filled rate set can never make
  // "is this an adults' halaqa" ambiguous for the screens that ask.
  isAdult               Boolean @default(false)
  absenceFee            Int     @default(0)
  lateFee               Int     @default(0)
  missedMemorizationFee Int     @default(0)

  teacher         Teacher              @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  students        Student[]
  managers        ManagerHalaqa[]
  announcements   HalaqaAnnouncement[]
  studentsOfMonth StudentOfMonth[]

  @@index([teacherId])
  @@map("halaqas")
}

// ─────────────────────────────────────────────────────────────────────────────
// Attendance
// ─────────────────────────────────────────────────────────────────────────────

model Attendance {
  id        Int              @id @default(autoincrement())
  studentId Int
  date      DateTime         @db.Date
  status    AttendanceStatus

  // Derived by the server (attended, but no recitation recorded that day) and
  // kept on the row rather than inferred from the ledger: if the fine is later
  // forgiven, the day was still a day he did not memorize.
  missedMemorization Boolean @default(false)

  notes     String?  @db.Text
  createdAt DateTime @default(now())

  student       Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  justification AbsenceJustification?

  @@unique([studentId, date])
  @@index([studentId])
  @@index([date])
  @@index([status])
  @@map("attendance")
}

// ─────────────────────────────────────────────────────────────────────────────
// Memorization Progress
// ─────────────────────────────────────────────────────────────────────────────

model MemorizationProgress {
  id               Int                 @id @default(autoincrement())
  studentId        Int
  // QURAN-only: which surah. Nullable because a HADITH row has none.
  surahNumber      Int?
  // Float so page entries can record half pages (1.5); the service keeps
  // every page value on a 0.5 step, and single hadiths whole.
  amountDone       Float
  memorizationType Memorization        @default(MEMORIZING)
  subject          MemorizationSubject @default(QURAN)
  unit             ProgressUnit        @default(PAGE)
  // HADITH-only free-text identity (a name, a number in whichever collection
  // the halaqa uses, a short description) — there is no fixed hadith list to
  // pick a number from the way surahNumber picks one off the mushaf.
  hadithReference  String?             @db.VarChar(500)
  recordedAt       DateTime            @default(now())
  date             DateTime            @db.Date
  updatedAt        DateTime            @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, recordedAt])
  @@index([studentId, surahNumber])
  @@map("memorization_progress")
}

// ─────────────────────────────────────────────────────────────────────────────
// Evaluation
// ─────────────────────────────────────────────────────────────────────────────

model Evaluation {
  id                Int      @id @default(autoincrement())
  studentId         Int
  teacherId         Int
  memorizationScore Float?
  tajweedScore      Float?
  fluencyScore      Float?
  disciplineScore   Float?
  overallScore      Float?
  notes             String?  @db.Text
  createdAt         DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([teacherId])
  @@map("evaluations")
}

// ─────────────────────────────────────────────────────────────────────────────
// Student Note (teacher → one student, or to all of them at once)
// ─────────────────────────────────────────────────────────────────────────────

// Written once however many students it is for: a note to "all students" is
// one row here and a recipient row per student, so the teacher edits or
// deletes it in one place, and a student who joins the halaqa later does not
// inherit it.
model StudentNote {
  id        Int      @id @default(autoincrement())
  teacherId Int
  note      String   @db.Text
  createdAt DateTime @default(now())

  teacher    Teacher                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  recipients StudentNoteRecipient[]

  @@index([teacherId])
  @@map("student_notes")
}

model StudentNoteRecipient {
  noteId    Int
  studentId Int

  note    StudentNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([noteId, studentId])
  @@index([studentId])
  @@map("student_note_recipients")
}

// ─────────────────────────────────────────────────────────────────────────────
// Halaqa Announcement (manager/admin → a whole halaqa)
// ─────────────────────────────────────────────────────────────────────────────

// News about the circle rather than about a student: the teacher is away, the
// session moves to 6pm, the halaqa is off for the holidays. Read by everyone
// tied to the halaqa; written by a manager assigned to it, or by an admin.
model HalaqaAnnouncement {
  id       Int     @id @default(autoincrement())
  halaqaId Int
  // The User who posted, not the Manager: an admin posts too and has no
  // manager row.
  authorId Int
  title    String  @db.VarChar(200)
  body     String  @db.Text
  // Shared by the rows of one "all halaqas" post: one row per halaqa keeps
  // every reader's scope a plain halaqaId match, and the batch is what the
  // feed collapses back into one item and what edit and delete act on.
  // Null for news posted to a single halaqa.
  batchId  String? @db.VarChar(36)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  halaqa Halaqa @relation(fields: [halaqaId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: deleting a manager's account must not silently
  // erase what a halaqa was told.
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  // Matches the only two queries there are — one halaqa's history, and a feed
  // over a set of halaqa ids — both ordered by createdAt.
  @@index([halaqaId, createdAt])
  @@index([batchId])
  @@map("halaqa_announcements")
}

// ─────────────────────────────────────────────────────────────────────────────
// Notification
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String   @db.VarChar(200)
  body      String   @db.Text
  isRead    Boolean  @default(false)
  // The child the news is about, so a parent with several children sees
  // only the selected one's. Null for news about no one child — and for rows
  // written before this column existed — which every child's list shows.
  studentId Int?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([studentId])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// Device token
// ─────────────────────────────────────────────────────────────────────────────

// One row per device a user has signed in on, holding the FCM registration
// token a notification is pushed to. Unique on the token rather than the user:
// a parent may carry a phone and a tablet and both should ring, while the same
// device arriving twice is the same token and re-points instead of duplicating.
model DeviceToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique @db.VarChar(255)
  platform  String   @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Manager
// ─────────────────────────────────────────────────────────────────────────────

model Manager {
  id                  Int      @id @default(autoincrement())
  userId              Int      @unique
  canManageAccounts   Boolean  @default(false)
  canDeleteAccounts   Boolean  @default(false)
  // Students with no halaqa have no ManagerHalaqa row to reach them through,
  // so the admin grants them to a manager with this flag instead.
  canAccessUnassigned Boolean  @default(false)
  // Lets the manager answer parents in the shared "الإدارة" chat, for the
  // parents whose children they can already reach. Admins always can.
  canChat             Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  halaqas        ManagerHalaqa[]
  justifications AbsenceJustification[]

  @@map("managers")
}

// ─────────────────────────────────────────────────────────────────────────────
// Junction: Manager ↔ Halaqa (many-to-many)
// ─────────────────────────────────────────────────────────────────────────────

model ManagerHalaqa {
  managerId  Int
  halaqaId   Int
  assignedAt DateTime @default(now())

  manager Manager @relation(fields: [managerId], references: [id], onDelete: Cascade)
  halaqa  Halaqa  @relation(fields: [halaqaId], references: [id], onDelete: Cascade)

  @@id([managerId, halaqaId])
  @@index([managerId])
  @@index([halaqaId])
  @@map("manager_halaqas")
}

// ─────────────────────────────────────────────────────────────────────────────
// Absence Justification
// ─────────────────────────────────────────────────────────────────────────────

model AbsenceJustification {
  id           Int                     @id @default(autoincrement())
  studentId    Int
  attendanceId Int                     @unique
  managerId    Int
  reasonType   JustificationReasonType
  customReason String?                 @db.VarChar(300)
  notes        String?                 @db.Text
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  manager    Manager    @relation(fields: [managerId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([managerId])
  @@index([attendanceId])
  @@map("absence_justifications")
}

// One row per charge or reduction against an adult student. The balance is the
// sum of these rather than a stored column, which would drift the first time a
// write path forgot to update it.
//
// Attendance writes are upserts — the teacher's sheet re-saves the same day on
// every tap — so an auto-charge is keyed by the day and reason it follows from
// and the unique index makes the second save a no-op. Manual entries leave
// `date` null, which MySQL treats as always distinct, so they never collide.
model FineEntry {
  id          Int        @id @default(autoincrement())
  studentId   Int
  kind        FineKind
  amount      Int
  // Null on auto-charges, where `source` already says why. Required on manual
  // entries, which have nothing else to explain them.
  reason      String?    @db.VarChar(300)
  source      FineSource
  date        DateTime?  @db.Date
  createdById Int
  createdAt   DateTime   @default(now())

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: deleting a teacher's account must not silently
  // erase what her students were charged.
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([studentId, date, source])
  @@index([studentId])
  @@index([createdById])
  @@map("fine_entries")
}

// One row per automatic day entry or manual adjustment. The total is the sum
// of rows, never a stored column. Keyed by user rather than student because
// teachers and managers have points too.
//
// Automatic rows are keyed by the day and reason they follow from, so the
// teacher re-saving a sheet can never add a second one. Manual rows leave
// `date` null, which MySQL treats as always distinct, so they never collide.
model PointEntry {
  id          Int         @id @default(autoincrement())
  userId      Int
  // Exact to a thousandth: a half page of revision is worth 0.125.
  amount      Decimal     @db.Decimal(10, 3)
  source      PointSource
  date        DateTime?   @db.Date
  reason      String?     @db.VarChar(300)
  // Null on automatic rows, which no one in particular created.
  createdById Int?
  createdAt   DateTime    @default(now())

  user      User  @relation("PointOwner", fields: [userId], references: [id], onDelete: Cascade)
  // Restrict, as on fines: removing a staff account must not erase the
  // adjustments it made.
  createdBy User? @relation("PointCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([userId, date, source])
  @@index([userId])
  @@index([createdById])
  @@map("point_entries")
}

// ─────────────────────────────────────────────────────────────────────────────
// Parent ↔ administration chat
// ─────────────────────────────────────────────────────────────────────────────

// One conversation per parent, with "the administration" as a whole: every
// admin and every manager allowed to reach that parent answers from the same
// thread. Who may see it is worked out on each request from the parent's
// children and the staff member's halaqas (see chat-access.ts), never stored,
// so moving a manager between halaqas takes effect at once.
model ChatConversation {
  id            Int      @id @default(autoincrement())
  parentId      Int      @unique
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  parent   Parent        @relation(fields: [parentId], references: [id], onDelete: Cascade)
  messages ChatMessage[]
  reads    ChatRead[]

  @@index([lastMessageAt])
  @@map("chat_conversations")
}

// The real staff sender is kept for accountability and for the staff view;
// the parent's view replaces it with "الإدارة" on the server.
//
// Deleting is soft: the row stays so ordering and read markers stay stable,
// but its text and photo are wiped. `updatedAt` is what an open chat polls on,
// so it notices edits and deletes, not only new rows.
model ChatMessage {
  id               Int       @id @default(autoincrement())
  conversationId   Int
  // Null once the sender's account is deleted: a manager leaving must not
  // erase their replies from a parent's history.
  senderUserId     Int?
  // Fixed when sent, so the side of a message survives its sender's deletion.
  fromStaff        Boolean
  body             String?   @db.Text
  imagePath        String?   @db.VarChar(255)
  editedAt         DateTime?
  deletedAt        DateTime?
  modifiedByUserId Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?            @relation("ChatMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, id])
  @@index([conversationId, updatedAt])
  @@index([senderUserId])
  @@map("chat_messages")
}

// Each person's own read position in a conversation. Unread is "messages from
// the other side after this id", so every staff member keeps their own count.
model ChatRead {
  conversationId    Int
  userId            Int
  lastReadMessageId Int

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("chat_reads")
}

// ─────────────────────────────────────────────────────────────────────────────
// طالب الشهر — one pick per halaqa per month
// ─────────────────────────────────────────────────────────────────────────────

// The teacher's validated choice for one finished month. The ranking itself is
// never stored: it is recomputed from the points and fines ledgers whenever the
// teacher opens the picker, so a late correction to the month still counts.
// `score` and `wasTopScorer` are a snapshot taken when the teacher validated,
// kept so the choice can be explained later even if the ledgers move.
//
// `month` is the month whose points were counted ("2026-11"), not the month
// the card is shown in: November's pick is shown through December.
model StudentOfMonth {
  id           Int      @id @default(autoincrement())
  halaqaId     Int
  month        String   @db.VarChar(7)
  studentId    Int
  score        Decimal  @db.Decimal(10, 3)
  wasTopScorer Boolean
  selectedById Int
  createdAt    DateTime @default(now())

  halaqa     Halaqa  @relation(fields: [halaqaId], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // Restrict, as on points and fines: removing a teacher must not erase the
  // record of whom they chose.
  selectedBy User    @relation(fields: [selectedById], references: [id], onDelete: Restrict)

  @@unique([halaqaId, month])
  @@index([studentId])
  @@index([selectedById])
  @@map("students_of_month")
}
