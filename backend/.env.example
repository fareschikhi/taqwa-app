# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env

# MySQL connection string used by Prisma.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/taqwa"
# Under docker compose the database is the `mysql` service, not localhost:
# DATABASE_URL="mysql://taqwa_user:<MYSQL_PASSWORD from .env.mysql>@mysql:3306/taqwa"

# Secret used to sign JWTs. Use a long random string in production, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-secret"

# How long an issued token stays valid (zeit/ms format: 60s, 24h, 7d).
JWT_EXPIRES_IN="30d"

# Port the NestJS API listens on.
PORT=3000

# Folder uploaded images are saved to. Optional: defaults to ./uploads. In
# production point it at a persistent volume, or images vanish on restart.
UPLOAD_DIR=""

# Firebase service account, from Project settings -> Service accounts ->
# Generate new private key. Optional: leave all three blank and the API starts
# with push delivery off, still writing notifications for the app to read.
# Set some but not all and it refuses to start, since that is a mistake.
# Keep the private key on one line, with the newlines escaped as \n.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
