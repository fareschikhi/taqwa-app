# Copy to `.env.mysql` and fill in two long random passwords, e.g.
#   openssl rand -hex 24
# Hex keeps them safe to paste into DATABASE_URL in .env, which must use the
# same MYSQL_PASSWORD.
#
# These only take effect when the database is first created. To change them
# on an existing database, run ALTER USER inside MySQL first, then edit here.
MYSQL_DATABASE=taqwa
MYSQL_USER=taqwa_user
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
