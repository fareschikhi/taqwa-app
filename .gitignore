# Node / NestJS
backend/node_modules/
backend/dist/
backend/.env
# Any local env variant (.env.aiven, .env.local, ...) holds real credentials.
# The example file is the one deliberate exception.
backend/.env.*
!backend/.env.example
backend/coverage/
# Images uploaded through the API while running locally.
backend/uploads/
backend/*.tsbuildinfo
# Local archives of the backend folder.
backend/*.rar

# Flutter
taqwa/.dart_tool/
taqwa/build/
taqwa/.idea/
taqwa/ios/Pods/
taqwa/**/Generated.xcconfig
taqwa/**/flutter_export_environment.sh

# Editors / OS
.vscode/
.DS_Store
Thumbs.db

# Database dumps (contain password hashes — never commit)
backups/
*.sql.bak

# Local scratch notes (may contain test credentials).
taqwa_note.txt
