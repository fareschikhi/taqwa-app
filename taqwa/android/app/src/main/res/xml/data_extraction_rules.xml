<?xml version="1.0" encoding="utf-8"?>
<!--
  The Android 12 and up form of backup_rules.xml. Both have to exist and
  agree: the platform reads this one from API 31 and the other below it.

  device-transfer is excluded for the same reason as cloud-backup — the
  AndroidKeyStore key does not move between devices either, so carrying the
  encrypted session across would only recreate the unreadable pair.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </device-transfer>
</data-extraction-rules>
